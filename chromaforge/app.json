{
  "expo": {
    "name": "Chromaforge",
    "slug": "chromaforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "android": {
      "package": "com.vhanma.chromaforge",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chromaforge to open an image and turn it into music.",
          "cameraPermission": "Allow Chromaforge to capture an image and turn it into music."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "minSdkVersion": 24
          }
        }
      ]
    ]
  }
}
